+function FactsLoader({ text }) {
+  const [idx, setIdx] = useState(() => Math.floor(Math.random() * BLOOD_FACTS.length))
+  const [show, setShow] = useState(true)
+  useEffect(() => {
+    const t = setInterval(() => {
+      setShow(false)
