+      </div>
+      <div className="facts-status">{text}</div>
+      <div className={`facts-card ${show ? "show" : "hide"}`}>
+        <div className="facts-eyebrow">Did you know?</div>
+        <div className="facts-text">{BLOOD_FACTS[idx]}</div>
+      </div>
+    </div>
+  )
+}
