diff --git a/nginx.conf b/nginx.conf
index b571d86..d9a9aab 100644
--- a/nginx.conf
+++ b/nginx.conf
@@ -16,13 +16,20 @@ server {
         proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
     }
 
+    # Hashed build assets are immutable — cache them aggressively
+    location /biological-age/assets/ {
+        add_header Cache-Control "public, max-age=31536000, immutable";
+    }
+
     # Biological Age React application
     location /biological-age/ {
+        add_header Cache-Control "no-cache";
         try_files $uri $uri/ /biological-age/index.html;
     }
 
     # Main FitTwins coaching website
     location / {
+        add_header Cache-Control "no-cache";
         try_files $uri $uri/ /index.html;
     }
